{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "noEmit" : true
  },
  "include": [
    "src/index.ts", "src/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
